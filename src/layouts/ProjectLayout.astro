---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
	project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;
const { title, summary, role, timeframe, stack, metrics, links } = project;
---

<BaseLayout title={title} description={summary}>
	<article>
		<header class="project-header">
			<h1>{title}</h1>
			<p class="summary">{summary}</p>

			<dl class="meta">
				{role && (<div><dt>Role</dt><dd>{role}</dd></div>)}
				{timeframe && (<div><dt>When</dt><dd>{timeframe}</dd></div>)}
				{stack.length > 0 && (<div><dt>Stack</dt><dd>{stack.join(', ')}</dd></div>)}
			</dl>

			{links.length > 0 && (
				<ul class="links">
					{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			)}
		</header>

		{metrics.length > 0 && (
			<section class="metrics" aria-label="Key results">
				{metrics.map((m) => (
					<div>
						<span class="value">{m.value}</span>
						<span class="label">{m.label}</span>
					</div>
				))}
			</section>
		)}

		<slot name="demo" />

		<div class="body">
			<slot />
		</div>
	</article>

	<p class="back"><a href="/">← All projects</a></p>
</BaseLayout>

<style>
	.project-header h1 {
		margin-bottom: 0.25rem;
	}

	.summary {
		font-size: 1.125rem;
		color: var(--muted);
		margin-top: 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 1.5rem 0 0;
		font-size: 0.875rem;
	}

	.meta dt {
		color: var(--muted);
	}

	.meta dd {
		margin: 0;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		list-style: none;
		padding: 0;
		font-size: 0.875rem;
	}

	.metrics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
		gap: 1rem;
		margin: 2rem 0;
		padding: 1.25rem 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}

	.metrics .value {
		display: block;
		font-size: 1.5rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.metrics .label {
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.body :global(h2) {
		margin-top: 2.5rem;
	}

	.back {
		margin-top: 3rem;
	}
</style>
