---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import { inlineHtml, plainText } from '../lib/inline';
import { byline, showCaseStudies } from '../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout showHeader={false}>
	<section class="intro">
		<img class="headshot" src="/eric.jpg" alt="Eric Knudson, smiling, in a cap and glasses outdoors" width="240" height="240" />
		<h1>Eric Knudson</h1>
		<p>{byline}</p>
	</section>

	<section aria-label="Projects">
		<ul class="project-list">
			{projects.map((p) => (
				<li id={p.id}>
					<div class="text">
						<h2>
							{showCaseStudies ? (
								<a href={`/projects/${p.id}`} set:html={inlineHtml(p.data.title)} />
							) : (
								<span set:html={inlineHtml(p.data.title)} />
							)}
						</h2>
						{/* A blank line in a summary starts a new paragraph. */}
						{p.data.summary.split(/\n+/).map((para) => <p set:html={inlineHtml(para)} />)}
						{p.data.links.length > 0 && (
							<ul class="links">
								{p.data.links.map((l) => <li><a href={l.href}>{l.label} ↗</a></li>)}
							</ul>
						)}
					</div>
					<ProjectMedia
						media={p.data.media}
						title={plainText(p.data.title)}
						url={p.data.links.find((l) => l.label.startsWith('Live'))?.href}
					/>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.headshot {
		display: block;
		width: 7.5rem;
		height: 7.5rem;
		border-radius: 50%;
		object-fit: cover;
		margin-top: 2rem;
	}

	.intro h1 {
		font-size: 2.25rem;
		margin-bottom: 0;
	}


	.project-list {
		list-style: none;
		padding: 0;
	}

	.project-list > li {
		display: grid;
		gap: 1rem;
		padding: 2rem 0;
		border-top: 1px solid var(--rule);
	}

	/* Side by side on wider screens: text left, framed media right. The list
	   breaks out of the 40rem text column so the media has room. */
	@media (min-width: 52rem) {
		.project-list {
			position: relative;
			left: 50%;
			transform: translateX(-50%);
			width: min(64rem, 100vw - 2.5rem);
		}

		.project-list > li {
			grid-template-columns: 2fr 3fr;
			gap: 2.5rem;
			align-items: center;
		}
	}

	.text h2 {
		margin: 0;
		font-size: 1.125rem;
	}

	.text h2 a {
		color: var(--text);
	}

	.text p {
		margin: 0.5rem 0 0;
		color: var(--muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
	}
</style>
