---
// Browser port of the Flask app in ericknudson/som-course-generator (commit 773462d).
// Data in src/data/som-courses.json was converted from that commit's static/*.csv files.
---

<section class="generator" aria-labelledby="generator-heading">
	<h2 id="generator-heading">Try it</h2>
	<p class="course" aria-live="polite" data-course>&nbsp;</p>
	<button type="button" data-generate>Create course</button>
</section>

<script>
	import data from '../data/som-courses.json';

	const bigrams: Record<string, [string[], number[]]> = data.bigrams as any;
	const existing = new Set(data.existing);

	function pick(words: string[], weights: number[]) {
		let r = Math.random() * weights.reduce((sum, w) => sum + w, 0);
		for (let i = 0; i < words.length; i++) {
			r -= weights[i];
			if (r < 0) return words[i];
		}
		return words[words.length - 1];
	}

	function generateOnce() {
		const output: string[] = [];
		let token = '*';
		while (true) {
			const [words, weights] = bigrams[token];
			// The first word is picked uniformly; later words follow the bigram distribution.
			token = output.length === 0 ? words[Math.floor(Math.random() * words.length)] : pick(words, weights);
			if (token === 'STOP') return output.join(' ');
			output.push(token);
		}
	}

	// Reject single words and exact matches with real courses, as the original did.
	function generate() {
		for (let attempt = 0; attempt < 100; attempt++) {
			const name = generateOnce();
			if (name.includes(' ') && !existing.has(name)) return name;
		}
		return generateOnce();
	}

	const course = document.querySelector<HTMLElement>('[data-course]')!;
	const show = () => (course.textContent = generate());
	document.querySelector('[data-generate]')!.addEventListener('click', show);
	show();
</script>

<style>
	.generator {
		margin: 2rem 0;
		padding: 1.5rem;
		border: 1px solid var(--rule);
		border-radius: 8px;
		text-align: center;
	}

	.generator h2 {
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.course {
		min-height: 3.5em;
		margin: 1rem 0;
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.3;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	button {
		font: inherit;
		font-weight: 600;
		padding: 0.5rem 1.25rem;
		border: 0;
		border-radius: 6px;
		background: var(--accent);
		color: var(--bg);
		cursor: pointer;
	}

	button:active {
		opacity: 0.8;
	}
</style>
